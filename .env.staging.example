# Vercel staging target. Use a dedicated, data-less Supabase environment and
# synthetic accounts only. Never reuse production credentials or copy user data.
APP_ENV=staging
NEXT_PUBLIC_SITE_URL=https://staging.studocyte.emeducate.com.au
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_STAGING_PROJECT.supabase.co
SUPABASE_EXPECTED_URL=https://REPLACE_STAGING_PROJECT.supabase.co
PRODUCTION_SUPABASE_URL=https://REPLACE_PRODUCTION_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_ENABLED=false
P0_RELEASE_APPROVED=false

# Keep production analytics, email, calendar, Zoom and paid AI providers out of
# staging until each integration receives isolated test credentials.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
INTERVIEW_VIDEO_MARKING_ENABLED=false
INTERVIEW_WHOLE_PANEL_MARKING_ENABLED=false
INTERVIEW_WORKER_SECRET=
CRON_SECRET=
INTERVIEW_VIDEO_RETENTION_DAYS=7
INTERVIEW_TURN_URLS=
INTERVIEW_TURN_USERNAME=
INTERVIEW_TURN_CREDENTIAL=
OPENAI_TRANSCRIPTION_API_KEY=
OPENAI_INTERVIEW_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_INTERVIEW_DIARIZATION_MODEL=gpt-4o-transcribe-diarize
OPENAI_INTERVIEW_MARKING_API_KEY=
OPENAI_INTERVIEW_MARKING_MODEL=gpt-5-mini
OPENAI_INTERVIEW_AUDIT_MODEL=gpt-5-mini
OPENAI_INTERVIEW_TRANSCRIPT_LAYOUT_API_KEY=

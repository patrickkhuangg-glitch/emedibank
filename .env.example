# ── Supabase (Phase 0) ──────────────────────────────────────────────────────
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe publishable key (sb_publishable_… ; older projects: "anon")
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret key (sb_secret_… ; older projects: "service_role"). Never commit.
SUPABASE_SECRET_KEY=

# ── Site (Phase 1) ──────────────────────────────────────────────────────────
# Absolute origin used for auth email + OAuth redirect URLs, canonical/OG URLs,
# robots and sitemap. Required; request Host headers are never trusted. Set it in
# Vercel to your production URL, e.g. https://studocyte.emeducate.com.au
NEXT_PUBLIC_SITE_URL=
APP_ENV=development
SUPABASE_EXPECTED_URL=
PRODUCTION_SUPABASE_URL=
PAYMENTS_ENABLED=false
P0_RELEASE_APPROVED=false

# ── Signup protection ───────────────────────────────────────────────────────
# Cloudflare Turnstile keys. Add the production domain to the Turnstile widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Public Google Analytics 4 stream ID. Analytics loads only after consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-886N2HS3Q2

# ── OpenAI (interview transcription) ───────────────────────────────────────
# Restricted project key with Model capabilities → Request and only
# gpt-4o-mini-transcribe allowed in that OpenAI project's model settings.
OPENAI_TRANSCRIPTION_API_KEY=

# ── Zoom tutoring ────────────────────────────────────────────────────────────
# Create a Server-to-Server OAuth app in Zoom Marketplace. Keep every value
# server-only. Configure the webhook endpoint as /api/zoom/webhook.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_HOST_USER_ID=               # Licensed Zoom host email or user ID
ZOOM_WEBHOOK_SECRET_TOKEN=

# Google Calendar OAuth (host calendar automation)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ── Stripe (Phase 1, test mode) ─────────────────────────────────────────────
# Publishable key (browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret key (server only) — never commit
STRIPE_SECRET_KEY=
# Webhook signing secret from `stripe listen` or the dashboard endpoint
STRIPE_WEBHOOK_SECRET=

# ── Mux (Phase 2, video explanations) ───────────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Signing key for signed playback URLs
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=          # base64 PEM private key
# Webhook signing secret (from the Mux dashboard webhook endpoint)
MUX_WEBHOOK_SECRET=
# Mux Data env key (browser, optional analytics)
NEXT_PUBLIC_MUX_ENV_KEY=

# ── Private interview video and human-approved marking ─────────────────────
# Default off. Apply migration 0033 in staging and complete the runbook first.
INTERVIEW_VIDEO_MARKING_ENABLED=false
# At least 32 random characters. Vercel sends CRON_SECRET in Authorization.
# Set both variables to the SAME secret. External schedulers send this bearer value.
INTERVIEW_WORKER_SECRET=
CRON_SECRET=
OPENAI_INTERVIEW_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Used only for consensual Live Practice room recordings with multiple speakers.
OPENAI_INTERVIEW_DIARIZATION_MODEL=gpt-4o-transcribe-diarize
# Server-only restricted Responses API key; may use a separate OpenAI project.
OPENAI_INTERVIEW_MARKING_API_KEY=
OPENAI_INTERVIEW_MARKING_MODEL=gpt-5-mini
OPENAI_INTERVIEW_AUDIT_MODEL=gpt-5-mini
INTERVIEW_VIDEO_RETENTION_DAYS=90

# Optional transcript-by-question grouping. Defaults to the transcription key.
# The chosen key needs access to the Responses API and the selected model.
OPENAI_INTERVIEW_TRANSCRIPT_LAYOUT_API_KEY=
OPENAI_INTERVIEW_TRANSCRIPT_LAYOUT_MODEL=gpt-4.1-mini

# Transcript grouping key priority: dedicated layout key, interview marking key,
# essay marking key, then transcription key. Audio transcription keeps its own key.
# Private off-site recording backups. Bucket-scoped object read/write credentials only.
# Keep the R2 bucket private; no r2.dev access, public domain or object version retention.
INTERVIEW_BACKUP_R2_ACCOUNT_ID=
INTERVIEW_BACKUP_R2_BUCKET=
INTERVIEW_BACKUP_R2_ACCESS_KEY_ID=
INTERVIEW_BACKUP_R2_SECRET_ACCESS_KEY=
INTERVIEW_SUPPORT_EMAIL=support@emeducate.com.au
INTERVIEW_BACKUP_OPERATOR_EMAIL=e.zhang@emeducate.com.au

# Operational alerts. Configure either Resend email (all three email values) or
# one private HTTPS webhook. Alerts contain operational codes, not student work.
INTERVIEW_ALERT_RESEND_API_KEY=
INTERVIEW_ALERT_EMAIL_TO=
INTERVIEW_ALERT_EMAIL_FROM=
INTERVIEW_ALERT_WEBHOOK_URL=

# Server-delivered WebRTC relay configuration for Live Practice. Use short-lived
# credentials from your TURN provider where available; never expose these as NEXT_PUBLIC values.
INTERVIEW_TURN_URLS=
INTERVIEW_TURN_USERNAME=
INTERVIEW_TURN_CREDENTIAL=

# Interview free trial (migration 0059/0060; leave database enabled=false until configured).
# Independent random server-only secret, at least 32 characters. Keep stable: rotating it
# without migrating identity hashes weakens protection against repeat trial signups.
INTERVIEW_TRIAL_IDENTITY_SECRET=
# Trial cloud allocation defaults to 60 minutes / 512 MiB; global warning/pause settings
# are in interview_trial_settings. See docs/INTERVIEW-FREE-TRIAL.md.

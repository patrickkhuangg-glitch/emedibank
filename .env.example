# ── Supabase (Phase 0) ──────────────────────────────────────────────────────
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe publishable key (sb_publishable_… ; older projects: "anon")
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only secret key (sb_secret_… ; older projects: "service_role"). Never commit.
SUPABASE_SECRET_KEY=

# ── Site (Phase 1) ──────────────────────────────────────────────────────────
# Absolute origin used for auth email + OAuth redirect URLs, canonical/OG URLs,
# robots and sitemap. Optional locally (falls back to the request host); set it in
# Vercel to your production URL, e.g. https://studocyte.emeducate.com.au
NEXT_PUBLIC_SITE_URL=

# Public Google Analytics 4 stream ID. Analytics loads only after consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-886N2HS3Q2

# ── OpenAI (interview transcription) ───────────────────────────────────────
# Restricted project key with Model capabilities → Request and only
# gpt-4o-mini-transcribe allowed in that OpenAI project's model settings.
OPENAI_TRANSCRIPTION_API_KEY=

# ── Stripe (Phase 1, test mode) ─────────────────────────────────────────────
# Publishable key (browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret key (server only) — never commit
STRIPE_SECRET_KEY=
# Webhook signing secret from `stripe listen` or the dashboard endpoint
STRIPE_WEBHOOK_SECRET=

# ── Mux (Phase 2, video explanations) ───────────────────────────────────────
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Signing key for signed playback URLs
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=          # base64 PEM private key
# Webhook signing secret (from the Mux dashboard webhook endpoint)
MUX_WEBHOOK_SECRET=
# Mux Data env key (browser, optional analytics)
NEXT_PUBLIC_MUX_ENV_KEY=

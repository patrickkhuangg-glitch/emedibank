# Supabase — Phase 0 (see SETUP-ACCOUNTS.md for where each value lives)
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Browser-safe publishable key (sb_publishable_… ; older projects: "anon" key)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret key (sb_secret_… ; older projects: "service_role" key)
# NEVER expose in the browser or commit a real value. Bypasses Row-Level Security.
SUPABASE_SECRET_KEY=

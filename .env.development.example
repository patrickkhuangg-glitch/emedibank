# Use local Supabase or a dedicated development project, never the production export.
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_EXPECTED_URL=http://127.0.0.1:54321
PRODUCTION_SUPABASE_URL=https://REPLACE_PRODUCTION_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENTS_ENABLED=false
P0_RELEASE_APPROVED=false

# Optional locally; without these, Live Practice uses direct/STUN connectivity.
INTERVIEW_TURN_URLS=
INTERVIEW_TURN_USERNAME=
INTERVIEW_TURN_CREDENTIAL=

{
  "name": "emedibank",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/validate-environment.mjs development",
    "check:environment": "node scripts/validate-environment.mjs",
    "check:staging": "node scripts/check-staging.mjs",
    "audit:database": "node scripts/audit-database.mjs",
    "scan:secrets": "python3 scripts/scan-secrets.py",
    "test:p0": "node --test tests/p0*.test.mjs",
    "dev": "next dev",
    "dev:staging": "node scripts/validate-environment.mjs staging && next dev",
    "build": "next build",
    "build:staging": "node scripts/validate-environment.mjs staging && next build",
    "start": "next start",
    "lint": "eslint",
    "test:audit": "node --test tests/audit-fixes.test.mjs",
    "test:security": "node --test tests/security-fixes.test.mjs",
    "seed:stripe": "node --env-file=.env.local scripts/seed-stripe.ts",
    "seed:interview-offers": "node --env-file=.env.local scripts/seed-interview-offers.ts",
    "test:interviews": "node --import ./tests/helpers/register-server-only.mjs --import tsx --test tests/interview*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@mux/mux-node": "^15.1.0",
    "@mux/mux-player-react": "^3.13.2",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^22.6.0",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}

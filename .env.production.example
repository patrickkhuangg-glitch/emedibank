# Vercel Production only. Supply secrets in the provider, not source control.
APP_ENV=production
NEXT_PUBLIC_SITE_URL=https://studocyte.emeducate.com.au
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_PRODUCTION_PROJECT.supabase.co
SUPABASE_EXPECTED_URL=https://REPLACE_PRODUCTION_PROJECT.supabase.co
PRODUCTION_SUPABASE_URL=https://REPLACE_PRODUCTION_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Keep both false until the P0 evidence register is signed off.
PAYMENTS_ENABLED=false
P0_RELEASE_APPROVED=false

# Live Practice relay. Configure all three together in Vercel Production.
INTERVIEW_TURN_URLS=
INTERVIEW_TURN_USERNAME=
INTERVIEW_TURN_CREDENTIAL=
OPENAI_INTERVIEW_DIARIZATION_MODEL=gpt-4o-transcribe-diarize

# Interview free trial (migration 0059/0060; leave database enabled=false until configured).
# Independent random server-only secret, at least 32 characters. Keep stable: rotating it
# without migrating identity hashes weakens protection against repeat trial signups.
INTERVIEW_TRIAL_IDENTITY_SECRET=
# Trial cloud allocation defaults to 60 minutes / 512 MiB; global warning/pause settings
# are in interview_trial_settings. See docs/INTERVIEW-FREE-TRIAL.md.
